# ==============================================================================
# Unity .gitignore standard template
# ==============================================================================

# Unity generated folders and files
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Aa]ssets/AssetStoreTools*

# Visual Studio / VS Code / Rider cache & project files
.vs/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# Unity crash reports
sysinfo.txt
*.stackdump

# OS generated files
.DS_Store
Thumbs.db
desktop.ini
